
{
  "entities": {
    "LocalUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Guest User",
      "type": "object",
      "description": "Stores guest visitor info and device links for session persistence.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "deviceIdentifier": { "type": "string" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Parlour": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Beauty Parlour",
      "type": "object",
      "description": "An elite beauty studio or parlour listing.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "areaTag": { "type": "string" },
        "address": { "type": "string", "description": "Full physical address of the studio." },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "imageUrls": { "type": "array", "items": { "type": "string" } },
        "myImage": { "type": "string", "description": "Custom artisan profile image." },
        "myCover": { "type": "string", "description": "Custom artisan cover banner." },
        "description": { "type": "string" },
        "ownerDashboardStyle": { "type": "string", "enum": ["list", "grid"] },
        "isDeliveryTeam": { "type": "boolean", "description": "True if this artisan is enrolled in the logistics team." }
      },
      "required": ["id", "name", "ownerId", "latitude", "longitude", "areaTag"]
    },
    "Deal": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Service Deal",
      "type": "object",
      "description": "Specialized service offers like Bridal Glow or Hair Spa.",
      "properties": {
        "id": { "type": "string" },
        "parlourId": { "type": "string" },
        "parlourOwnerId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Bridal", "Hair", "Skin"] },
        "basePrice": { "type": "number" },
        "discountPrice": { "type": "number" },
        "currency": { "type": "string", "enum": ["PKR", "INR"] },
        "expiryDate": { "type": "string", "format": "date-time" },
        "depositPercent": { "type": "number" },
        "upsellProductId": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["id", "parlourId", "name", "category", "discountPrice", "currency", "depositPercent"]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Makeup Item",
      "type": "object",
      "description": "Professional makeup products available in the shop.",
      "properties": {
        "id": { "type": "string" },
        "vendorId": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "basePrice": { "type": "number" },
        "price": { "type": "number", "description": "The final selling price after discount." },
        "currency": { "type": "string", "enum": ["PKR", "INR"] },
        "stockCount": { "type": "number" },
        "weightKg": { "type": "number" },
        "imageUrl": { "type": "string" },
        "discountExpiry": { "type": "string", "format": "date-time" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["id", "name", "brand", "price", "currency", "stockCount"]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking & Order",
      "type": "object",
      "description": "Combined record of service bookings and product orders.",
      "properties": {
        "id": { "type": "string" },
        "localUserId": { "type": "string" },
        "vendorId": { "type": "string" },
        "riderId": { "type": "string", "description": "The ID of the rider/artisan who committed to this delivery." },
        "referenceCode": { "type": "string" },
        "totalPrice": { "type": "number" },
        "shippingCost": { "type": "number" },
        "currency": { "type": "string", "enum": ["PKR", "INR"] },
        "qrVerified": { "type": "boolean" },
        "deliveryStatus": { "type": "string", "enum": ["Pending", "Picked Up", "Delivered", "Committed", "Verified"] },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "groupSize": { "type": "number" },
        "inspirationImageUrl": { "type": "string" },
        "shippingAddress": { "type": "string", "description": "Customer provided delivery address." },
        "isReviewed": { "type": "boolean" }
      },
      "required": ["id", "localUserId", "referenceCode", "totalPrice", "currency", "deliveryStatus", "createdAt"]
    },
    "Review": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer Review",
      "type": "object",
      "description": "Verified feedback left by customers.",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "targetId": { "type": "string" },
        "vendorId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetId", "userId", "rating", "comment", "isVerified", "createdAt"]
    },
    "Conversation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Chat Conversation",
      "type": "object",
      "description": "A chat thread between two people.",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "vendorName": { "type": "string" },
        "vendorImage": { "type": "string" }
      },
      "required": ["id", "participants", "updatedAt"]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Chat Message",
      "type": "object",
      "description": "A single text message in a thread.",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "text", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "/parlours/{parlourId}": {
      "schema": { "$ref": "#/backend/entities/Parlour" },
      "description": "Elite parlour listings."
    },
    "/deals/{dealId}": {
      "schema": { "$ref": "#/backend/entities/Deal" },
      "description": "Special beauty offers."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Marketplace makeup items."
    },
    "/localUsers/{localUserId}": {
      "schema": { "$ref": "#/backend/entities/LocalUser" },
      "description": "Guest user profiles."
    },
    "/localUsers/{localUserId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/backend/entities/Booking" },
      "description": "User specific orders."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/backend/entities/Review" },
      "description": "Verified customer feedback."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/backend/entities/Conversation" },
      "description": "Threads for messaging."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/backend/entities/Message" },
      "description": "Messages inside threads."
    }
  }
}
