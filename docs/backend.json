
{
  "entities": {
    "LocalUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Guest User",
      "type": "object",
      "description": "Stores guest visitor info and device links for session persistence.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID for the user."
        },
        "name": {
          "type": "string",
          "description": "The user's full name."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's mobile number."
        },
        "deviceIdentifier": {
          "type": "string",
          "description": "ID for the user's phone or computer."
        },
        "lastActiveAt": {
          "type": "string",
          "description": "When the user last used the app.",
          "format": "date-time"
        },
        "latitude": {
          "type": "number",
          "description": "Last known latitude."
        },
        "longitude": {
          "type": "number",
          "description": "Last known longitude."
        }
      },
      "required": [
        "id",
        "name",
        "phoneNumber"
      ]
    },
    "Parlour": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Beauty Parlour",
      "type": "object",
      "description": "An elite beauty studio or parlour listing.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID."
        },
        "name": {
          "type": "string",
          "description": "The name of the parlour."
        },
        "ownerId": {
          "type": "string",
          "description": "The UID of the parlour owner."
        },
        "latitude": {
          "type": "number",
          "description": "Map location (lat)."
        },
        "longitude": {
          "type": "number",
          "description": "Map location (long)."
        },
        "areaTag": {
          "type": "string",
          "description": "The city or neighborhood name."
        },
        "rating": {
          "type": "number",
          "description": "Average stars out of 5."
        },
        "imageUrls": {
          "type": "array",
          "description": "Photos of the parlour.",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "Detailed studio description."
        },
        "ownerDashboardStyle": {
          "type": "string",
          "description": "Owner dashboard view preference.",
          "enum": ["list", "grid"]
        }
      },
      "required": [
        "id",
        "name",
        "ownerId",
        "latitude",
        "longitude",
        "areaTag"
      ]
    },
    "Deal": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Service Deal",
      "type": "object",
      "description": "Specialized service offers like Bridal Glow or Hair Spa.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID."
        },
        "parlourId": {
          "type": "string",
          "description": "Associated parlour ID."
        },
        "parlourOwnerId": {
          "type": "string",
          "description": "Associated owner UID."
        },
        "name": {
          "type": "string",
          "description": "Service name."
        },
        "category": {
          "type": "string",
          "description": "Type of service.",
          "enum": ["Bridal", "Hair", "Skin"]
        },
        "basePrice": {
          "type": "number",
          "description": "Original price."
        },
        "discountPrice": {
          "type": "number",
          "description": "Offer price."
        },
        "currency": {
          "type": "string",
          "description": "PKR or INR.",
          "enum": ["PKR", "INR"]
        },
        "expiryDate": {
          "type": "string",
          "description": "Deal expiration.",
          "format": "date-time"
        },
        "depositPercent": {
          "type": "number",
          "description": "Percentage to pay upfront."
        },
        "upsellProductId": {
          "type": "string",
          "description": "Recommended product ID."
        }
      },
      "required": [
        "id",
        "parlourId",
        "name",
        "category",
        "discountPrice",
        "currency",
        "depositPercent"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Makeup Item",
      "type": "object",
      "description": "Professional makeup products available in the shop.",
      "properties": {
        "id": {
          "type": "string"
        },
        "vendorId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["PKR", "INR"]
        },
        "stockCount": {
          "type": "number"
        },
        "weightKg": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "brand",
        "price",
        "currency",
        "stockCount"
      ]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking & Order",
      "type": "object",
      "description": "Combined record of service bookings and product orders.",
      "properties": {
        "id": {
          "type": "string"
        },
        "localUserId": {
          "type": "string"
        },
        "vendorId": {
          "type": "string"
        },
        "referenceCode": {
          "type": "string"
        },
        "totalPrice": {
          "type": "number"
        },
        "shippingCost": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["PKR", "INR"]
        },
        "qrVerified": {
          "type": "boolean"
        },
        "deliveryStatus": {
          "type": "string",
          "enum": ["Pending", "Picked Up", "Delivered"]
        },
        "paymentStatus": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "groupSize": {
          "type": "number"
        },
        "inspirationImageUrl": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "localUserId",
        "referenceCode",
        "totalPrice",
        "currency",
        "deliveryStatus",
        "createdAt"
      ]
    },
    "Review": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer Review",
      "type": "object",
      "description": "Verified feedback left by customers.",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "targetId": { "type": "string", "description": "ID of the Parlour or Product reviewed." },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetId", "userId", "rating", "comment", "isVerified", "createdAt"]
    },
    "GlobalConfig": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Global Configuration",
      "type": "object",
      "properties": {
        "exchangeRatePKRtoINR": { "type": "number" },
        "platformCommissionRate": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/parlours/{parlourId}": {
      "schema": { "$ref": "#/backend/entities/Parlour" },
      "description": "Elite parlour listings."
    },
    "/deals/{dealId}": {
      "schema": { "$ref": "#/backend/entities/Deal" },
      "description": "Special beauty offers."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Marketplace makeup items."
    },
    "/localUsers/{localUserId}": {
      "schema": { "$ref": "#/backend/entities/LocalUser" },
      "description": "Guest user profiles."
    },
    "/localUsers/{localUserId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/backend/entities/Booking" },
      "description": "User specific orders."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/backend/entities/Review" },
      "description": "Verified customer feedback."
    },
    "/globalConfig/defaultConfig": {
      "schema": { "$ref": "#/backend/entities/GlobalConfig" },
      "description": "Platform settings."
    }
  }
}
