
{
  "entities": {
    "LocalUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LocalUser",
      "type": "object",
      "description": "Stores basic user information locally on the device for guest browsing and to remember user history without full authentication.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the LocalUser entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the user."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's contact phone number."
        },
        "deviceIdentifier": {
          "type": "string",
          "description": "A unique identifier representing the user's specific device."
        },
        "lastActiveAt": {
          "type": "string",
          "description": "Timestamp of last activity.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "phoneNumber",
        "deviceIdentifier"
      ]
    },
    "Parlour": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Parlour",
      "type": "object",
      "description": "Represents a beauty parlour offering services.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Parlour entity."
        },
        "name": {
          "type": "string",
          "description": "The official name of the beauty parlour."
        },
        "latitude": {
          "type": "number",
          "description": "Geographical latitude."
        },
        "longitude": {
          "type": "number",
          "description": "Geographical longitude."
        },
        "areaTag": {
          "type": "string",
          "description": "Geographical area or locality."
        },
        "rating": {
          "type": "number",
          "description": "Average rating."
        },
        "imageUrls": {
          "type": "array",
          "description": "Images of the parlour.",
          "items": {
            "type": "string"
          }
        },
        "ownerDashboardStyle": {
          "type": "string",
          "description": "Preferred dashboard style: 'list' or 'grid'.",
          "enum": ["list", "grid"]
        }
      },
      "required": [
        "id",
        "name",
        "latitude",
        "longitude",
        "areaTag"
      ]
    },
    "Deal": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Deal",
      "type": "object",
      "description": "Represents a specific beauty service or package.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "parlourId": {
          "type": "string",
          "description": "Reference to Parlour."
        },
        "name": {
          "type": "string",
          "description": "Deal title."
        },
        "category": {
          "type": "string",
          "description": "Deal category (Bridal, Hair, Skin)."
        },
        "originalPrice": {
          "type": "number",
          "description": "Full price."
        },
        "discountPrice": {
          "type": "number",
          "description": "Discounted price."
        },
        "currency": {
          "type": "string",
          "description": "Price currency."
        },
        "expiryDate": {
          "type": "string",
          "description": "Expiration date.",
          "format": "date-time"
        },
        "depositPercent": {
          "type": "number",
          "description": "Upfront deposit percentage."
        },
        "upsellProductId": {
          "type": "string",
          "description": "Complementary makeup product ID."
        }
      },
      "required": [
        "id",
        "parlourId",
        "name",
        "category",
        "originalPrice",
        "discountPrice",
        "currency",
        "expiryDate",
        "depositPercent"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a makeup product.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "name": {
          "type": "string",
          "description": "Product name."
        },
        "brand": {
          "type": "string",
          "description": "Brand name."
        },
        "basePrice": {
          "type": "number",
          "description": "Price before discounts."
        },
        "currency": {
          "type": "string",
          "description": "Currency code."
        },
        "stockCount": {
          "type": "number",
          "description": "Units in stock."
        },
        "weightKg": {
          "type": "number",
          "description": "Weight for delivery fee calculation."
        },
        "imageUrl": {
          "type": "string",
          "description": "Product image URL."
        }
      },
      "required": [
        "id",
        "name",
        "brand",
        "basePrice",
        "currency",
        "stockCount"
      ]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "Represents a user's consolidated booking or order.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "localUserId": {
          "type": "string",
          "description": "Owning user ID."
        },
        "referenceCode": {
          "type": "string",
          "description": "User-facing reference code."
        },
        "totalPrice": {
          "type": "number",
          "description": "Total order value."
        },
        "currency": {
          "type": "string",
          "description": "Currency code."
        },
        "qrVerificationStatus": {
          "type": "boolean",
          "description": "Verified by parlour."
        },
        "deliveryStatus": {
          "type": "string",
          "description": "Tracking status for product orders.",
          "enum": ["Pending", "Picked Up", "Delivered"]
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp.",
          "format": "date-time"
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment state."
        }
      },
      "required": [
        "id",
        "localUserId",
        "referenceCode",
        "totalPrice",
        "currency",
        "qrVerificationStatus",
        "deliveryStatus",
        "createdAt",
        "paymentStatus"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/parlours/{parlourId}": {
      "schema": { "$ref": "#/backend/entities/Parlour" },
      "description": "Parlour metadata."
    },
    "/deals/{dealId}": {
      "schema": { "$ref": "#/backend/entities/Deal" },
      "description": "Service deals."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Shop products."
    },
    "/localUsers/{localUserId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/backend/entities/Booking" },
      "description": "User orders and bookings."
    }
  }
}
