{
  "entities": {
    "LocalUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Guest User",
      "type": "object",
      "description": "Stores basic info for visitors so they can see their history without a password.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID for the user."
        },
        "name": {
          "type": "string",
          "description": "The user's full name."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's mobile number."
        },
        "deviceIdentifier": {
          "type": "string",
          "description": "ID for the user's phone or computer."
        },
        "lastActiveAt": {
          "type": "string",
          "description": "When the user last used the app.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "phoneNumber",
        "deviceIdentifier"
      ]
    },
    "Parlour": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Beauty Parlour",
      "type": "object",
      "description": "A beauty shop or parlour that offers services.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID for the parlour."
        },
        "name": {
          "type": "string",
          "description": "The name of the parlour."
        },
        "latitude": {
          "type": "number",
          "description": "Map location (lat)."
        },
        "longitude": {
          "type": "number",
          "description": "Map location (long)."
        },
        "areaTag": {
          "type": "string",
          "description": "The city or neighborhood name."
        },
        "rating": {
          "type": "number",
          "description": "Average stars out of 5."
        },
        "imageUrls": {
          "type": "array",
          "description": "Photos of the parlour.",
          "items": {
            "type": "string"
          }
        },
        "ownerDashboardStyle": {
          "type": "string",
          "description": "How the owner sees their schedule: 'list' or 'grid'.",
          "enum": ["list", "grid"]
        }
      },
      "required": [
        "id",
        "name",
        "latitude",
        "longitude",
        "areaTag"
      ]
    },
    "Deal": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Service Deal",
      "type": "object",
      "description": "A special offer for a beauty service like a facial or hair cut.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID."
        },
        "parlourId": {
          "type": "string",
          "description": "Which parlour offers this deal."
        },
        "name": {
          "type": "string",
          "description": "The name of the service (e.g., Bridal Glow)."
        },
        "category": {
          "type": "string",
          "description": "Type of service: Bridal, Hair, or Skin."
        },
        "originalPrice": {
          "type": "number",
          "description": "Old price."
        },
        "discountPrice": {
          "type": "number",
          "description": "New low price."
        },
        "currency": {
          "type": "string",
          "description": "PKR or INR."
        },
        "expiryDate": {
          "type": "string",
          "description": "When the deal ends.",
          "format": "date-time"
        },
        "depositPercent": {
          "type": "number",
          "description": "Money to pay now to book (percentage)."
        },
        "upsellProductId": {
          "type": "string",
          "description": "A makeup product that goes well with this service."
        }
      },
      "required": [
        "id",
        "parlourId",
        "name",
        "category",
        "originalPrice",
        "discountPrice",
        "currency",
        "expiryDate",
        "depositPercent"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Makeup Item",
      "type": "object",
      "description": "A makeup or beauty product for sale.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID."
        },
        "name": {
          "type": "string",
          "description": "The name of the item."
        },
        "brand": {
          "type": "string",
          "description": "Company name."
        },
        "basePrice": {
          "type": "number",
          "description": "Price of the item."
        },
        "currency": {
          "type": "string",
          "description": "PKR or INR."
        },
        "stockCount": {
          "type": "number",
          "description": "How many items are left."
        },
        "weightKg": {
          "type": "number",
          "description": "Weight for delivery costs."
        },
        "imageUrl": {
          "type": "string",
          "description": "Photo of the item."
        }
      },
      "required": [
        "id",
        "name",
        "brand",
        "basePrice",
        "currency",
        "stockCount"
      ]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking & Order",
      "type": "object",
      "description": "Information about a user's service booking or product order.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID."
        },
        "localUserId": {
          "type": "string",
          "description": "The user who booked this."
        },
        "referenceCode": {
          "type": "string",
          "description": "Code to show at the parlour."
        },
        "totalPrice": {
          "type": "number",
          "description": "Total amount."
        },
        "currency": {
          "type": "string",
          "description": "PKR or INR."
        },
        "qrVerificationStatus": {
          "type": "boolean",
          "description": "Has the parlour checked the code?"
        },
        "deliveryStatus": {
          "type": "string",
          "description": "Is the item on the way?",
          "enum": ["Pending", "Picked Up", "Delivered"]
        },
        "createdAt": {
          "type": "string",
          "description": "When this was made.",
          "format": "date-time"
        },
        "paymentStatus": {
          "type": "string",
          "description": "Paid or Unpaid."
        }
      },
      "required": [
        "id",
        "localUserId",
        "referenceCode",
        "totalPrice",
        "currency",
        "qrVerificationStatus",
        "deliveryStatus",
        "createdAt",
        "paymentStatus"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/parlours/{parlourId}": {
      "schema": { "$ref": "#/backend/entities/Parlour" },
      "description": "Info about beauty parlours."
    },
    "/deals/{dealId}": {
      "schema": { "$ref": "#/backend/entities/Deal" },
      "description": "Special service offers."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Makeup items in the shop."
    },
    "/localUsers/{localUserId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/backend/entities/Booking" },
      "description": "Your saved bookings and orders."
    }
  }
}
