
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if only rating fields are being updated
    function isRatingUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']);
    }

    // --- MARKETPLACE DATA ---
    match /parlours/{parlourId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        isRatingUpdate()
      );
    }
    
    match /deals/{dealId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.parlourOwnerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.parlourOwnerId == request.auth.uid || 
        isRatingUpdate()
      );
    }
    
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.vendorId == request.auth.uid || 
        isRatingUpdate()
      );
    }

    // --- USER DATA & BOOKINGS ---
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /sessions/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /localUsers/{localUserId} {
      allow read, write: if true; 
      match /bookings/{bookingId} {
        allow read, write: if true;
      }
    }

    match /bookings/{bookingId} {
      allow read, create: if true;
      allow update: if isAuthenticated() && (
        resource.data.vendorId == request.auth.uid || 
        resource.data.localUserId == request.auth.uid ||
        request.auth.uid == resource.data.riderId ||
        (resource.data.riderId == null && get(/databases/$(database)/documents/parlours/$(request.auth.uid)).data.isDeliveryTeam == true)
      );
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
    }

    // --- CHAT SYSTEM ---
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
      }
    }

    // Platform settings
    match /globalConfig/defaultConfig {
      allow read: if true;
      allow write: if false;
    }
  }
}
