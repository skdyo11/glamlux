rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- MARKETPLACE DATA (B2C) ---
    // Anyone can browse deals, products, and vendors
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(vendorId);
    }
    
    match /deals/{dealId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.data.vendor_id == request.auth.uid;
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.data.vendor_id == request.auth.uid;
    }

    // --- USER DATA & SESSIONS ---
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Nested sessions
      match /sessions/{sessionId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // --- BOOKINGS (COD) ---
    // Customers can create bookings (anonymous or auth). 
    // Vendors can only read bookings assigned to them.
    match /bookings/{bookingId} {
      allow create: if true; // COD B2C flow
      allow read: if (isAuthenticated() && (
        resource.data.vendorId == request.auth.uid || 
        resource.data.localUserId == request.auth.uid
      ));
      allow update: if isAuthenticated() && resource.data.vendorId == request.auth.uid;
    }
  }
}
