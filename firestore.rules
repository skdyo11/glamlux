rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- MARKETPLACE DATA ---
    // Anyone can browse parlours, deals, and products. 
    // Only owners can modify their own listings.
    match /parlours/{parlourId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        (request.method == 'create' && request.resource.data.ownerId == request.auth.uid) ||
        (request.method == 'update' && resource.data.ownerId == request.auth.uid)
      );
    }
    
    match /deals/{dealId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        (request.method == 'create' && request.resource.data.parlourOwnerId == request.auth.uid) ||
        (request.method == 'update' && resource.data.parlourOwnerId == request.auth.uid)
      );
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        (request.method == 'create' && request.resource.data.vendorId == request.auth.uid) ||
        (request.method == 'update' && resource.data.vendorId == request.auth.uid)
      );
    }

    // --- USER DATA & BOOKINGS ---
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /sessions/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /localUsers/{localUserId} {
      allow read, write: if true; // Guest profile access
      match /bookings/{bookingId} {
        allow read, write: if true;
      }
    }

    match /bookings/{bookingId} {
      allow read, create: if true;
      allow update: if isAuthenticated() && (
        resource.data.vendorId == request.auth.uid || 
        resource.data.localUserId == request.auth.uid
      );
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
    }

    // Platform settings
    match /globalConfig/defaultConfig {
      allow read: if true;
      allow write: if false; // System only
    }
  }
}